    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import matplotlib.ticker as mticker\n",
    "\n",
    "print(\"statistics data:\")\n",
    "stats = df_result[['viewCount', 'likeCount', 'commentCount']].describe() # show generate basic descriptive statistics\n",
    "print(stats)\n",
    "\n",
    "df_result['publishedAt'] = pd.to_datetime(df_result['publishedAt']) # convert the publishedAt column to datetime format\n",
    "df_result['hour'] = df_result['publishedAt'].dt.hour # extract \"hour\" information from the timestamp\n",
    "\n",
    "# Set up matplotlib chart styles:\n",
    "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
    "plt.rcParams.update({\n",
    "    \"figure.facecolor\": \"#FAFAFA\",\n",
    "    \"axes.facecolor\":   \"#FAFAFA\",\n",
    "    \"axes.edgecolor\":   \"#CCCCCC\",\n",
    "    \"axes.linewidth\":   0.8,\n",
    "    \"grid.color\":       \"#E5E5E5\",\n",
    "    \"grid.linewidth\":   0.6,\n",
    "    \"font.family\":      \"DejaVu Sans\",\n",
    "})\n",
    "\n",
    "# ACCENT   = \"#E05C4B\"  \n",
    "# ACCENT2  = \"#F59A23\"   \n",
    "LABEL_SZ = 12\n",
    "TITLE_SZ = 14\n",
    "\n",
    "# GRAPH 1：View Count vs Like Count \n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "\n",
    "ax.scatter(\n",
    "    df_result[\"viewCount\"], # X-axis\n",
    "    df_result[\"likeCount\"], # Y-axis\n",
    "    # set up for the plot\n",
    "    color= \"#E05C4B\", \n",
    "    alpha=0.55, # Transparency\n",
    "    s=50, # point size\n",
    "    edgecolors=\"white\", # point border color\n",
    "    linewidths=0.5,\n",
    ")\n",
    "\n",
    "# set chart title, X-axis, Y-axis labels\n",
    "ax.set_title(\"View Count vs. Like Count (Trending Videos)\",\n",
    "             fontsize=TITLE_SZ, fontweight=\"bold\", pad=14)\n",
    "ax.set_xlabel(\"View Count\", fontsize=LABEL_SZ, labelpad=8)\n",
    "ax.set_ylabel(\"Like Count\", fontsize=LABEL_SZ, labelpad=8)\n",
    "\n",
    "# format numbers with thousand separators\n",
    "ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f\"{x:,.0f}\"))\n",
    "ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f\"{x:,.0f}\"))\n",
    "\n",
    "# adjust tick styles\n",
    "ax.tick_params(axis=\"both\", labelsize=10, length=0)\n",
    "\n",
    "# remove top and right spines\n",
    "sns.despine(ax=ax, left=True, bottom=True)\n",
    "\n",
    "#  adjust layout automatically to prevent overlap\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# GRAPH 2：Upload Hour Distribution \n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "\n",
    "# plot histogram\n",
    "sns.histplot(\n",
    "    df_result[\"hour\"], # upload hour data\n",
    "    bins=24, # divide into 24 hours\n",
    "    binrange=(0, 24),\n",
    "    color=\"#F59A23\",\n",
    "    edgecolor=\"white\",\n",
    "    linewidth=0.6,\n",
    "    alpha=0.9,\n",
    "    ax=ax,\n",
    ")\n",
    "\n",
    "ax.set_title(\"Distribution of Upload Hours (UTC)\",\n",
