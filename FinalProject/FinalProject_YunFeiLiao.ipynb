    "import openai\n",
    "\n",
    "# initializing OpenAI client\n",
    "client = openai.OpenAI(\n",
    "    base_url=\"http://localhost:11434/v1\",\n",
    "    api_key=\"ollama\"\n",
    ")\n",
    "\n",
    "# this function is used for AI to generate analysis conclusions\n",
    "def getconclusion(df, model_name=\"gemma3:4b\"):\n",
    "    stats = df[['viewCount', 'likeCount', 'commentCount']].describe() # get information for 'viewCount', 'likeCount', and 'commentCount' \n",
    "    top_titles = df['title'].head(50).tolist() \n",
    "    stats_text = stats.to_string()\n",
    "    \n",
    "    prompt = f\"\"\"\n",
    "    Please provide a professional summary based on the following YouTube trending data:\n",
    "    1. Analyze the distribution of view counts (mean, max, etc.).\n",
    "    2. Evaluate audience engagement through likes and comments.\n",
    "    3. Identify common themes among the top 50 performing video titles.\n",
    "    \n",
    "    Data Statistics:\n",
    "    {stats_text}\n",
    "    \n",
    "    Top 50 Trending Titles:\n",
    "    {', '.join(top_titles)}\n",
    "    \n",
    "    Conclusion:\n",
    "    \"\"\"\n",
    "    \n",
    "    try:\n",
    "        response = client.chat.completions.create( # call ollama 4b version to generate the analysis results\n",
    "            model=model_name, # (model_name=\"gemma3:4b\")\n",
    "            messages=[{\"role\": \"user\", \"content\": prompt}]\n",
    "        )\n",
    "        return response.choices[0].message.content # return content\n",
    "    except Exception as e: # return fail message if function fail to execute\n",
    "        return f\"Error: {e}.\"\n",
    "\n",
    "print(\"--- AI Generated Conclusion ---\")\n",
    "conclusion = getconclusion(df_result, \"gemma3:4b\") # call function\n",
    "print(conclusion)"
   ]
  },
