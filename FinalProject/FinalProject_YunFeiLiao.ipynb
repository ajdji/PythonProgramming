    "from googleapiclient.discovery import build\n",
    "import pandas as pd\n",
    "\n",
    "API_KEY = '' \n",
    "REGION_CODE = 'US' # Set the country code to query\n",
    "\n",
    "# Initialize connection to the YouTube API\n",
    "youtube = build('youtube', 'v3', developerKey=API_KEY)\n",
    "\n",
    "def get_trend(region='US'):\n",
    "    all_items = []\n",
    "    next_page_token = None \n",
    "    \"\"\"\n",
    "    this token(next_page_token = None) is used to tell the API how and where to get the next page of data \n",
    "    as YouTube API only allows grabbing the maximum of 50 sets of data each time. And I need 100 sets of data\n",
    "    because the number of data sets might shrink after the data cleaning process \n",
    "    and not meeting requirement of analyze top 50 videos.\n",
    "    \"\"\"\n",
    "\n",
    "    for _ in range(2):\n",
    "        # call YouTube API twice to retrieve top 100 trending videos\n",
    "        video_response = youtube.videos().list(\n",
    "            part='statistics,snippet', # retrieve statistics and basic video info\n",
    "            chart='mostPopular', # under Most Popular chart\n",
    "            regionCode=region, # Region: US\n",
    "            maxResults=50, # call top 50 records \n",
    "            pageToken=next_page_token # token for the next page (top 51-100 videos)\n",
    "        ).execute()\n",
    "        \n",
    "        all_items.extend(video_response.get('items', [])) # append current page items to all_items\n",
    "        next_page_token = video_response.get('nextPageToken') # get the next page token\n",
    "        \n",
    "        if not next_page_token: # if there is no next page then stop the loop\n",
    "            break\n",
    "\n",
    "    data = [] # set up a list to organize data for the DataFrame\n",
    "    for item in all_items:\n",
    "        v_id = item['id'] # v_id = id of each videos\n",
    "        stats = item['statistics']\n",
    "        # put required fields into a dictionary\n",
    "        data.append({\n",
    "            'title': item['snippet']['title'], # Video Title\n",
    "            'channelTitle': item['snippet']['channelTitle'], # Channel Name\n",
    "            'publishedAt': item['snippet']['publishedAt'], # Publish Time\n",
    "            'url': f'https://www.youtube.com/watch?v={v_id}', # URL of video\n",
    "            'viewCount': int(stats.get('viewCount', 0)),\n",
    "            'likeCount': int(stats.get('likeCount', 0)),\n",
    "            'commentCount': int(stats.get('commentCount', 0))\n",
    "        })\n",
    "    # create a DataFrame\n",
    "    df = pd.DataFrame(data)\n",
    "    # save raw data\n",
    "    df.to_csv('raw_data.csv', index=False, encoding='utf-8-sig')\n",
    "    print(\"!!!!!!!raw_data.csv SAVED!!!!!!!\")\n",
    "    \n",
    "    # save the new DataFrame\n",
    "    df = pd.DataFrame(data)\n",
    "    # filter out videos which has all 0 for views, likes, and comments.\n",
    "    condition = (df['viewCount'] == 0) & (df['likeCount'] == 0) & (df['commentCount'] == 0)\n",
    "    df_filtered = df[~condition].copy()\n",
    "    \n",
    "    df_final = df_filtered.head(50).reset_index(drop=True)# keep the top 50 only\n",
    "    \n",
    "    df_final.index += 1 # i just want the index to be shown from 1 (1-50) rather 0 (0-49)\n",
    "    \n",
    "    return df_final\n",
    "\n",
    "df_result = get_trend(REGION_CODE) # execute function\n",
    "\n",
    "df_result.to_csv('YTtop50_intheUS.csv', index_label='ID', encoding='utf-8-sig') # store the data into one CSV file\n",
    "\n",
    "print(\"!!!!!!!YTtop50_intheUS.csv SAVED!!!!!!!\")\n",
    "print(\"(the file is placed inside the same Github folder.)\")\n",
    "print(\"\\nshow part of the content of YTtop50_intheUS.csv:\\n\")\n",
    "print(df_result.head()) # show the CSV file"
   ]
