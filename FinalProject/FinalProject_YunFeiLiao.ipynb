    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import matplotlib.ticker as mticker\n",
    "\n",
    "\n",
    "def load_data(file_path):\n",
    "    df = pd.read_csv(file_path) # read the CSV file\n",
    "    df['publishedAt'] = pd.to_datetime(df['publishedAt']) # convert 'publishedAt' to datetime format\n",
    "    df['hour'] = df['publishedAt'].dt.hour # extract hour information from the timestamp\n",
    "    num_cols = ['viewCount', 'likeCount', 'commentCount'] # define columns that need to be converted to numeric format\n",
    "    for col in num_cols: # convert columns to numeric format\n",
    "        df[col] = pd.to_numeric(df[col], errors='coerce').fillna(0) # replace NaN with 0\n",
    "    return df\n",
    "\n",
    "csv_filename = 'YTtop50_intheUS.csv'\n",
    "df_result = load_data(csv_filename)\n",
    "print(\"statistics data:\")\n",
    "stats = df_result[['viewCount', 'likeCount', 'commentCount']].describe()\n",
    "print(stats)\n",
    "\n",
    "# chart styles\n",
    "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
    "plt.rcParams.update({\n",
    "    \"figure.facecolor\": \"#FAFAFA\",\n",
    "    \"axes.facecolor\":   \"#FAFAFA\",\n",
    "    \"axes.edgecolor\":   \"#CCCCCC\",\n",
    "    \"axes.linewidth\":   0.8,\n",
    "    \"grid.color\":       \"#E5E5E5\",\n",
    "    \"grid.linewidth\":   0.6,\n",
    "    \"font.family\":      \"DejaVu Sans\",\n",
    "})\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "ax.scatter(\n",
    "    df_result[\"viewCount\"], \n",
    "    df_result[\"likeCount\"], \n",
    "    color= \"#E05C4B\", \n",
    "    alpha=0.55, \n",
    "    s=50, \n",
    "    edgecolors=\"white\", \n",
    "    linewidths=0.5,\n",
    ")\n",
    "ax.set_title(\"View Count vs. Like Count (Trending Videos)\", fontsize=14, fontweight=\"bold\", pad=14)\n",
    "ax.set_xlabel(\"View Count\", fontsize=12, labelpad=8)\n",
    "ax.set_ylabel(\"Like Count\", fontsize=12, labelpad=8)\n",
    "ax.xaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f\"{x:,.0f}\"))\n",
    "ax.yaxis.set_major_formatter(mticker.FuncFormatter(lambda x, _: f\"{x:,.0f}\"))\n",
    "ax.tick_params(axis=\"both\", labelsize=10, length=0)\n",
    "sns.despine(ax=ax, left=True, bottom=True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "sns.histplot(\n",
    "    df_result[\"hour\"], \n",
    "    bins=24, \n",
    "    binrange=(0, 24), \n",
    "    color=\"#F59A23\", \n",
    "    edgecolor=\"white\", \n",
    "    linewidth=0.6, \n",
    "    alpha=0.9, \n",
    "    ax=ax,\n",
    ")\n",
    "ax.set_title(\"Distribution of Upload Hours (UTC)\", fontsize=14, fontweight=\"bold\", pad=14)\n",
    "ax.set_xlabel(\"Hour of Day (0–23, UTC)\", fontsize=12, labelpad=8)\n",
    "ax.set_ylabel(\"Number of Videos\", fontsize=12, labelpad=8)\n",
    "ax.set_xticks(range(0, 24))\n",
    "ax.tick_params(axis=\"both\", labelsize=10, length=0)\n",
    "sns.despine(ax=ax, left=True, bottom=True)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
